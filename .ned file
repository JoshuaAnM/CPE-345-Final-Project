import org.omnetpp.queueing.Source;
import org.omnetpp.queueing.Queue;
import org.omnetpp.queueing.Router;
import org.omnetpp.queueing.Sink;

network UFCStreamingSimulation
{
    submodules:
        viewers: Source {
            @display("p=90,160");
        }

        mainServerQueue: Queue {
            @display("p=240,160");
            gates:
                in[1];
        }

        router: Router {
            @display("p=390,160");
            gates:
                in[1];
                out[2];
        }

        normalServer: Queue {
            @display("p=540,100");
            gates:
                in[1];
        }

        backupServer: Queue {
            @display("p=540,220");
            gates:
                in[1];
        }

        sink: Sink {
            @display("p=700,160");
            gates:
                in[2];
        }

    connections:
        viewers.out --> mainServerQueue.in[0];
        mainServerQueue.out --> router.in[0];

        router.out[0] --> normalServer.in[0];
        router.out[1] --> backupServer.in[0];

        normalServer.out --> sink.in[0];
        backupServer.out --> sink.in[1];
}
